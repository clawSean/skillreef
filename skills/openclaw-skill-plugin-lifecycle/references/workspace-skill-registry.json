{
  "schemaVersion": 1,
  "authorization": {
    "workspaceOwner": {
      "principal": "workspace-owner",
      "resolve": {
        "kind": "openclaw-owner-authority",
        "declarations": [
          "USER.md",
          "IDENTITY.md"
        ]
      }
    },
    "defaults": {
      "workspaceSkillEditors": [
        "workspace-owner"
      ],
      "newSkillDestination": "workshop",
      "autonomousSkillDestination": "workshop"
    },
    "principals": {
      "person:example-collaborator": {
        "resolve": {
          "kind": "host-injected-principal-id",
          "principalId": "person:example-collaborator"
        }
      }
    },
    "skillEditorExceptions": {
      "food-ordering": [
        "person:example-collaborator"
      ],
      "shop-agent": [
        "person:example-collaborator"
      ]
    }
  },
  "publication": {
    "skillreef": {
      "repository": "clawSean/skillreef",
      "checkout": "~/projects/clawSean/skillreef",
      "skills": {
